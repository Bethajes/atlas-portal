# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/atlas_portal?schema=public"

# JWT Secrets
JWT_SECRET="your_jwt_secret"
REFRESH_SECRET="your_refresh_secret"

# Server Configuration
PORT=5000
NODE_ENV="development"
BACKEND_URL="http://localhost:5000"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Email Configuration
EMAIL_USER="your.email@gmail.com"
EMAIL_PASS="your_app_password"

# Chapa Configuration (Optional)
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxx"
CHAPA_WEBHOOK_SECRET="your_chapa_webhook_secret"
CHAPA_API_URL="https://api.chapa.co/v1"

# ArifPay / Awash Birr Configuration
ARIFPAY_API_KEY="your_arifpay_api_key"
ARIFPAY_WEBHOOK_SECRET="your_arifpay_webhook_secret"
ARIFPAY_BASE_URL="https://developer.arifpay.org/awash/transfer/direct"

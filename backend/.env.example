# ================================================================
# Atlas Portal — Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ================================================================

# ── Database ──────────────────────────────────────────────────
# Local development: postgresql://user:password@localhost:5432/atlas_portal
# Render production: automatically injected from the linked database
DATABASE_URL="postgresql://user:password@localhost:5432/atlas_portal?schema=public"

# ── JWT ───────────────────────────────────────────────────────
# Generate strong random values in production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Render: set generateValue: true in render.yaml (already configured)
JWT_SECRET="change-me-with-a-long-random-hex-string"
REFRESH_SECRET="change-me-with-a-different-long-random-hex-string"

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ── CORS / Frontend URL ───────────────────────────────────────
# Local: http://localhost:5173
# Vercel production: https://your-frontend.vercel.app
FRONTEND_URL="http://localhost:5173"

# ── Email (optional — for password reset emails) ──────────────
EMAIL_USER=""
EMAIL_PASS=""

# ── Chapa Payment Gateway (optional) ──────────────────────────
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your_chapa_webhook_secret"
CHAPA_API_URL="https://api.chapa.co/v1"

# ── ArifPay / Awash Birr (optional) ───────────────────────────
ARIFPAY_API_KEY="your_arifpay_api_key"
ARIFPAY_WEBHOOK_SECRET="your_arifpay_webhook_secret"
ARIFPAY_BASE_URL="https://developer.arifpay.org/awash/transfer/direct"
